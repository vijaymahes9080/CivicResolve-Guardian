{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceItem",
  "type": "object",
  "required": ["id", "complaint_id", "file_name", "file_type", "file_size_bytes", "storage_path", "uploaded_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "complaint_id": { "type": "string", "format": "uuid" },
    "file_name": { "type": "string" },
    "file_type": { "type": "string", "enum": ["image/jpeg", "image/png", "application/pdf", "audio/webm", "audio/wav", "audio/mp3"] },
    "file_size_bytes": { "type": "integer", "maximum": 10485760 },
    "storage_path": { "type": "string" },
    "is_redacted": { "type": "boolean", "default": false },
    "sha256_hash": { "type": "string" },
    "description": { "type": "string" },
    "uploaded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
