{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResolutionAssessment",
  "type": "object",
  "required": [
    "id",
    "complaint_id",
    "evaluation_verdict",
    "confidence",
    "explanation",
    "deterministic_checks_passed",
    "contradiction_detected",
    "evidence_references",
    "evaluated_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "complaint_id": { "type": "string", "format": "uuid" },
    "evaluation_verdict": {
      "type": "string",
      "enum": ["likely_resolved", "weak_resolution", "insufficient_evidence", "contradiction_detected"]
    },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "explanation": { "type": "string" },
    "deterministic_checks_passed": { "type": "boolean" },
    "checks_detail": {
      "type": "object",
      "properties": {
        "required_fields_present": { "type": "boolean" },
        "resolution_evidence_attached": { "type": "boolean" },
        "dates_consistent": { "type": "boolean" },
        "addressed_requested_issue": { "type": "boolean" },
        "valid_status_transition": { "type": "boolean" }
      }
    },
    "contradiction_detected": { "type": "boolean" },
    "contradiction_notes": { "type": "string" },
    "evidence_references": { "type": "array", "items": { "type": "string" } },
    "citizen_satisfaction_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "evaluated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
