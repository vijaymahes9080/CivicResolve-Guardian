{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyDocument",
  "type": "object",
  "required": ["id", "title", "department", "jurisdiction", "sla_hours", "sections"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "department": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "version": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "sla_hours": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "title", "content"],
        "properties": {
          "section_id": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "evidence_required": { "type": "array", "items": { "type": "string" } },
          "escalation_path": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
