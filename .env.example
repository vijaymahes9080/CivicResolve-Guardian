# CivicResolve Guardian Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="CivicResolve Guardian"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & JWT
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for zero-setup local dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./civicresolve.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicresolve

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# AI & RAG Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
RAG_SIMILARITY_THRESHOLD=0.50
DUPLICATE_SIMILARITY_THRESHOLD=0.75

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
